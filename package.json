{
  "name": "rhodes-index",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "collect": "python scripts/tag_collect.py collect",
    "collect:status": "python scripts/tag_collect.py status",
    "collect:stop": "python scripts/tag_collect.py stop",
    "test:http": "python -m unittest discover -s scripts -p test_tag_*.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/domain.test.ts server/aggregate.test.ts server/storage.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^15.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
